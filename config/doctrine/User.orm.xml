<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Model\User" table="users" repository-class="Doctrine\ORM\EntityRepository">

        <id name="id" type="uuid" column="id"/>
        <field name="email" type="text" column="email"/>
        <field name="firstname" type="text" column="firstname"/>
        <field name="lastname" type="text" column="lastname"/>

    </entity>
</doctrine-mapping>
